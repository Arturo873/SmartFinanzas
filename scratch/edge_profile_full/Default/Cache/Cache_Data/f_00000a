    // 3. Generación de Checkboxes para cada Período Histórico (RF-04)
    function renderizarCheckboxesPeriodos() {
        if (!listaCheckboxes) return;
        listaCheckboxes.innerHTML = '';

        if (periodosUnicos.length === 0) {
