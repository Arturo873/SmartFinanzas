    // =========================================================================
    // PLUGIN 1: BANDAS DE FONDO DEL SEMÁFORO (Verde 0-35, Amarillo 35-70, Rojo 70-100)
    // =========================================================================
    const trafficLightBandsPlugin = {
        id: 'trafficLightBands',
        beforeDraw: function(chart) {
            const { ctx, chartArea, scales: { y } } = chart;
            if (!chartArea || !y) return;
            ctx.save();

            const yTop = chartArea.top;
            const y70 = y.getPixelForValue(70);
            const y35 = y.getPixelForValue(35);
            const yBottom = chartArea.bottom;

            // Franja Roja (Zona Crítica de Insolvencia: 70 a 100)
            ctx.fillStyle = 'rgba(254, 226, 226, 0.45)'; // #fee2e2
            ctx.fillRect(chartArea.left, yTop, chartArea.width, y70 - yTop);

            // Franja Amarilla (Zona Preventiva / Alerta: 35 a 70)
            ctx.fillStyle = 'rgba(254, 249, 195, 0.45)'; // #fef9c3
            ctx.fillRect(chartArea.left, y70, chartArea.width, y35 - y70);

            // Franja Verde (Zona Solvente: 0 a 35)
            ctx.fillStyle = 'rgba(220, 252, 231, 0.45)'; // #dcfce7
            ctx.fillRect(chartArea.left, y35, chartArea.width, yBottom - y35);

            // Líneas divisorias de umbral sutiles
            ctx.strokeStyle = 'rgba(220, 38, 38, 0.35)';
            ctx.setLineDash([4, 4]);
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(chartArea.left, y70);
            ctx.lineTo(chartArea.right, y70);
            ctx.stroke();

            ctx.strokeStyle = 'rgba(202, 138, 4, 0.35)';
            ctx.beginPath();
            ctx.moveTo(chartArea.left, y35);
            ctx.lineTo(chartArea.right, y35);
            ctx.stroke();

            // Rótulos explicativos en la franja
            ctx.font = '600 10px Inter, system-ui, sans-serif';
            ctx.fillStyle = 'rgba(185, 28, 28, 0.85)';
            ctx.fillText('Zona Crítica de Insolvencia (>70%)', chartArea.left + 8, yTop + 14);

            ctx.fillStyle = 'rgba(161, 98, 7, 0.85)';
            ctx.fillText('Zona Preventiva / Alerta (35-70%)', chartArea.left + 8, y70 + 14);

            ctx.fillStyle = 'rgba(21, 128, 61, 0.85)';
            ctx.fillText('Zona Solvente (0-35%)', chartArea.left + 8, y35 + 14);

            ctx.restore();
        }
    };

    // =========================================================================
    // PLUGIN 2: LOCALIZADOR CROSSHAIR TIPO RETÍCULA DE INFERENCIA ACTIVA [ACTUAL]
    // =========================================================================
    const activePointLocatorPlugin = {
        id: 'activePointLocator',
        afterDatasetsDraw: function(chart) {
            const activeIdx = esActualArr.findIndex(v => Boolean(v));
            if (activeIdx === -1) return;

            let meta = null;
            if (chart.isDatasetVisible(0)) meta = chart.getDatasetMeta(0);
            else if (chart.isDatasetVisible(1)) meta = chart.getDatasetMeta(1);
            else if (chart.isDatasetVisible(2)) meta = chart.getDatasetMeta(2);

            if (!meta || !meta.data || !meta.data[activeIdx]) return;

            const point = meta.data[activeIdx];
            if (!point || typeof point.x !== 'number' || typeof point.y !== 'number') return;

            const ctxCanvas = chart.ctx;
            const chartArea = chart.chartArea;

            ctxCanvas.save();

            // 1. Línea guía vertical (crosshair hacia el eje X)
            ctxCanvas.beginPath();
            ctxCanvas.setLineDash([3, 3]);
            ctxCanvas.strokeStyle = '#94a3b8';
            ctxCanvas.lineWidth = 1.25;
            ctxCanvas.moveTo(point.x, point.y + 11);
            ctxCanvas.lineTo(point.x, chartArea.bottom);
            ctxCanvas.stroke();

            // 2. Halo exterior concéntrico tipo retícula
            ctxCanvas.beginPath();
            ctxCanvas.setLineDash([]);
            ctxCanvas.arc(point.x, point.y, 14, 0, Math.PI * 2);
            ctxCanvas.strokeStyle = 'rgba(37, 99, 235, 0.45)';
            ctxCanvas.lineWidth = 2;
            ctxCanvas.stroke();

            // 3. Badge flotante utilitario ("ACTUAL")
            const label = 'ACTUAL';
            ctxCanvas.font = "bold 9px 'Inter', sans-serif";
            const textWidth = ctxCanvas.measureText(label).width;
            const badgeW = textWidth + 12;
            const badgeH = 16;

            let badgeY = point.y - 26;
            if (badgeY < chartArea.top + 2) {
                badgeY = point.y + 16;
            }
            const badgeX = Math.max(chartArea.left + 4, Math.min(point.x - (badgeW / 2), chartArea.right - badgeW - 4));

            ctxCanvas.fillStyle = '#0f172a';
            ctxCanvas.beginPath();
            if (typeof ctxCanvas.roundRect === 'function') {
                ctxCanvas.roundRect(badgeX, badgeY, badgeW, badgeH, 3);
            } else {
                ctxCanvas.rect(badgeX, badgeY, badgeW, badgeH);
            }
            ctxCanvas.fill();

            ctxCanvas.fillStyle = '#ffffff';
            ctxCanvas.textAlign = 'center';
            ctxCanvas.textBaseline = 'middle';
            ctxCanvas.fillText(label, badgeX + (badgeW / 2), badgeY + (badgeH / 2) + 0.5);

            ctxCanvas.restore();
        }
    };

    // =========================================================================
    // INICIALIZACIÓN DEL GRÁFICO (Chart.js)
    // =========================================================================
    const chartInstance = new Chart(canvasChart, {
        type: 'line',
        plugins: [trafficLightBandsPlugin, activePointLocatorPlugin],
