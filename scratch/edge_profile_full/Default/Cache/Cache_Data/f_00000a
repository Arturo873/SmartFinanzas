                    borderWidth: 3,
                    borderDash: [6, 6],
                    pointBackgroundColor: [],
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2.5,
                    pointRadius: [],
                    pointHoverRadius: [],
                    tension: 0.1,
                    fill: false,
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'nearest',
                intersect: true,
            },
            onClick: function(event, elements) {
                if (!elements || elements.length === 0) return;
                const el = elements[0];
                const dataIndex = el.index;

                // Si se hace clic en el nodo destino proyectado, no alterar
                if (el.datasetIndex === 1 && dataIndex === destIdxActual) return;

                const punto = puntosVisiblesActuales[dataIndex];
                if (!punto) return;

                // Posicionar inmediatamente la proyección saliendo de este período
                posicionarEnPeriodo(punto.periodo);
            },
            onHover: function(event, elements) {
                const target = event.native ? event.native.target : canvasChart;
                if (target) {
                    target.style.cursor = (elements && elements.length > 0) ? 'pointer' : 'default';
                }
            },
            scales: {
                y: {
                    min: 0,
                    max: 100,
                    ticks: {
                        stepSize: 20,
                        callback: function(v) { return v + '%'; },
                        font: { size: 11, family: 'monospace' }
                    },
                    grid: {
                        color: 'rgba(226, 232, 240, 0.5)'
                    },
                    title: {
                        display: true,
                        text: 'Nivel de Riesgo / Deterioro (%)',
                        font: { size: 11, weight: '500' }
                    }
                },
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        font: function(context) {
                            const lastIdx = chartInstance ? (chartInstance.data.labels.length - 1) : -1;
                            if (context.index === lastIdx) {
                                return { size: 12, weight: 'bold', family: 'monospace' };
                            }
                            return { size: 11, family: 'monospace' };
                        },
                        color: function(context) {
                            const lastIdx = chartInstance ? (chartInstance.data.labels.length - 1) : -1;
                            if (context.index === lastIdx) {
                                return colorProyeccionActual.border;
                            }
                            return '#475569';
                        }
                    }
                }
            },
            plugins: {
                legend: {
                    display: false // Usamos la leyenda personalizada de la cabecera
                },
                tooltip: {
                    backgroundColor: '#0f172a',
                    titleFont: { size: 12, weight: 'bold' },
                    bodyFont: { size: 11 },
                    padding: 10,
                    cornerRadius: 6,
                    filter: function(tooltipItem) {
                        if (tooltipItem.datasetIndex === 1 && tooltipItem.dataIndex !== destIdxActual) {
                            return !visibilidadSeries.observados;
                        }
                        return true;
                    },
                    callbacks: {
                        title: function(items) {
                            if (!items || !items.length) return '';
                            const idx = items[0].dataIndex;
                            if (items[0].datasetIndex === 1 && idx === destIdxActual) {
                                return 'Pronóstico Preventivo AI (90 días - Q(t+1)): ' + items[0].label;
                            }
                            const isAct = esActualArr[idx];
                            return 'Trimestre ' + items[0].label + (isAct ? '  [ACTUAL]' : '');
                        },
                        label: function(ctx) {
                            const val = ctx.parsed.y;
                            if (val === null || val === undefined) return '';
                            const idx = ctx.dataIndex;

                            if (ctx.datasetIndex === 1) {
                                if (idx !== destIdxActual) {
                                    return 'Riesgo Observado Base (Q_t): ' + val.toFixed(1) + '%';
                                }
                                let estadoProy = val > 70 ? 'Crítica (>70%)' : (val > 35 ? 'Preventiva / Alerta (35-70%)' : 'Solvente (≤35%)');
                                return 'Pronóstico Machine Learning 90d: ' + val.toFixed(1) + '% | Probabilidad de Insolvencia: ' + estadoProy;
                            }

                            let zonaTexto = val > 70 ? 'Zona Crítica' : (val > 35 ? 'Zona Gris' : 'Zona Segura');
                            return 'Riesgo: ' + val.toFixed(1) + '% | ' + zonaTexto;
                        },
                        afterLabel: function(ctx) {
                            const idx = ctx.dataIndex;
                            if (ctx.datasetIndex === 1) {
                                if (idx !== destIdxActual) {
                                    return '● Balance actual seleccionado (punto de partida de la proyección)';
                                }
                                const origenStr = puntoActivoActual ? ` desde ${puntoActivoActual.label}` : '';
                                return `Pronóstico preventivo generado por Random Forest AI anticipando el estado en ${ctx.label}${origenStr}.`;
                            }
                            if (esActualArr[idx]) {
                                if (visibilidadSeries.proyeccion && puntoActivoActual) {
                                    return `● Balance actual seleccionado (pronóstico 90d a ${puntoActivoActual.periodo_proyectado}: ${puntoActivoActual.score_prediccion.toFixed(1)}%)`;
                                }
                                return '● Balance actual seleccionado';
                            }
                            return '👉 Clic para situar el análisis en este trimestre';
                        }
                    }
                }
            }
        }
    });

    // =========================================================================
    // 4. POSICIONAMIENTO DINÁMICO EN UN PERÍODO
    // =========================================================================
    function posicionarEnPeriodo(periodo) {
        puntosOriginales.forEach(p => {
            p.es_actual = (p.periodo === periodo);
        });

        if (!periodosSeleccionados.has(periodo)) {
            periodosSeleccionados.add(periodo);
            const chk = document.querySelector(`.check-periodo-item[value="${periodo}"]`);
            if (chk) chk.checked = true;
        }

        renderizarCheckboxesPeriodos();
        aplicarFiltrosYActualizar();

        // Actualizar URL sin recargar la página
        try {
            const url = new URL(window.location.href);
            url.searchParams.set('periodo', periodo);
            const punto = puntosOriginales.find(p => p.periodo === periodo);
            if (punto && punto.id) {
                url.searchParams.set('prediccion_id', punto.id);
            }
            window.history.replaceState(null, '', url.toString());
        } catch (e) {}
    }

    // =========================================================================
    // 5. ACTUALIZACIÓN DE LA TARJETA DE HORIZONTE
    // =========================================================================
    function actualizarCabeceraHorizonte(punto, activeIdx, visibles) {
        if (!punto) return;

        const elBase = document.getElementById('horizontePeriodoBase');
        if (elBase) elBase.textContent = punto.label || punto.periodo;

        const elProy = document.getElementById('horizontePeriodoProyectado');
        if (elProy) elProy.textContent = punto.periodo_proyectado || 'Q_{t+1}';

        const elScore = document.getElementById('horizonteScoreProyectado');
        if (elScore) elScore.textContent = punto.score_prediccion.toFixed(1) + '%';

        const elProgress = document.getElementById('horizonteProgressBar');
        if (elProgress) {
            elProgress.style.width = Math.min(100, Math.max(0, punto.score_prediccion)) + '%';
            elProgress.className = 'progress-bar ' + (punto.score_prediccion > 70 ? 'bg-danger' : (punto.score_prediccion > 35 ? 'bg-warning' : 'bg-success'));
        }

        const elBadgeNivel = document.getElementById('horizonteBadgeNivel');
        if (elBadgeNivel) {
            if (punto.score_prediccion > 70) {
                elBadgeNivel.innerHTML = '<span class="badge border badge-status-critico fs-micro">Riesgo Crítico</span>';
            } else if (punto.score_prediccion > 35) {
                elBadgeNivel.innerHTML = '<span class="badge border badge-status-alerta fs-micro">Alerta Preventiva</span>';
            } else {
                elBadgeNivel.innerHTML = '<span class="badge border badge-status-solvente fs-micro">Solvente</span>';
            }
        }

        const elBoxProy = document.getElementById('horizonteBoxProyectado');
        if (elBoxProy) {
            const col = punto.score_prediccion > 70 ? '#dc2626' : (punto.score_prediccion > 35 ? '#ca8a04' : '#16a34a');
            elBoxProy.style.borderLeft = `3px solid ${col}`;
        }

        // Actualizar URL del botón de descarga de informe en el modal para apuntar al período activo
        actualizarUrlDescargaPdf(punto.periodo, punto.id);
    }

    // =========================================================================
    // 5.B ACTUALIZACIÓN REACTIVA DEL PLAN DE RECOMENDACIONES PREVENTIVAS
    // =========================================================================
    function actualizarSeccionRecomendaciones(punto) {
        if (!punto) return;
        const perKey = punto.periodo;
        const lblKey = punto.label;
        const pidKey = punto.id ? String(punto.id) : null;

        const plan = punto.recomendaciones ||
                     (pidKey && recomendacionesPorPeriodo[pidKey]) ||
                     recomendacionesPorPeriodo[perKey] ||
                     recomendacionesPorPeriodo[lblKey];

        if (!plan) return;

        // 1. Actualizar metadatos de cabecera
        const elPeriodo = document.getElementById('recPeriodoTexto');
        if (elPeriodo) {
            elPeriodo.textContent = (plan.meta && plan.meta.periodo_label) || punto.label || punto.periodo;
        }

        // 2. Actualizar Bloque Macro
        if (plan.macro) {
            const m = plan.macro;
            const elBloqueMacro = document.getElementById('bloqueRecMacro');
            if (elBloqueMacro) {
                let colBorder = '#16a34a';
                if (m.clase_badge === 'badge-status-critico') colBorder = '#dc2626';
                else if (m.clase_badge === 'badge-status-alerta') colBorder = '#ca8a04';
                elBloqueMacro.style.borderLeft = `5px solid ${colBorder}`;
            }

            const elPrioridad = document.getElementById('recMacroPrioridad');
            if (elPrioridad) elPrioridad.textContent = `Prioridad: ${m.prioridad || 'Alta'}`;

            const elTitulo = document.getElementById('recMacroTitulo');
            if (elTitulo) elTitulo.textContent = m.titulo || 'Plan de Acción Preventivo';

            const elAccion = document.getElementById('recMacroAccion');
            if (elAccion) elAccion.textContent = m.accion_principal || '';

            const elPasosLista = document.getElementById('recMacroPasosLista');
            if (elPasosLista && Array.isArray(m.procedimiento_pasos)) {
                elPasosLista.innerHTML = m.procedimiento_pasos.map(paso => `<li>${paso}</li>`).join('');
            }

            const elFuente = document.getElementById('recMacroFuenteTexto');
            if (elFuente) elFuente.textContent = m.cita_fuente || '';
        }

        // 3. Actualizar Bloque Táctico
        const contenedorTacticas = document.getElementById('contenedorRecTacticas');
        if (contenedorTacticas && Array.isArray(plan.tacticas)) {
            if (plan.tacticas.length === 0) {
                contenedorTacticas.innerHTML = `<div class="col-12 text-center py-3 text-muted-custom fs-caption">No se registran medidas tácticas adicionales para este período.</div>`;
            } else {
                contenedorTacticas.innerHTML = plan.tacticas.map(tac => {
                    let badgeClase = 'badge-status-solvente';
                    if (tac.prioridad === 'Alta') badgeClase = 'badge-status-critico';
                    else if (tac.prioridad === 'Media') badgeClase = 'badge-status-alerta';

                    const diagHtml = tac.diagnostico_operativo ? `
                        <div class="p-2.5 rounded-2 bg-white border border-subtle mb-2.5 fs-caption text-main lh-base">
                            <strong class="d-block text-secondary fs-micro text-uppercase tracking-wider mb-1">
                                Situación Actual:
                            </strong>
                            ${tac.diagnostico_operativo}
                        </div>` : '';

                    const procHtml = tac.procedimiento ? `
                        <div class="p-2.5 rounded bg-white border border-subtle mb-2 fs-micro text-secondary">
                            <strong class="text-main d-block mb-1">
                                Paso a Paso Sugerido:
                            </strong>
                            ${tac.procedimiento}
                        </div>` : '';

                    return `
                    <div class="col-12 col-md-4">
                        <div class="p-3 rounded-3 border border-default bg-canvas shadow-xs h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge border font-monospace badge-status-neutral fs-micro">
                                        ${tac.grupo_riesgo || 'Financiero'}
                                    </span>
                                    <span class="badge border ${badgeClase} fs-micro">
                                        ${tac.prioridad}
                                    </span>
                                </div>

                                <h5 class="text-main fw-semibold fs-6 mb-2 lh-sm">
                                    ${tac.titulo}
                                </h5>

                                ${diagHtml}

                                <div class="mb-2.5">
                                    <strong class="d-block text-secondary fs-micro text-uppercase tracking-wider mb-1">
                                        Acción Recomendada:
                                    </strong>
                                    <p class="text-secondary fs-caption mb-0 lh-base">
                                        ${tac.que_hacer}
                                    </p>
                                </div>

                                ${procHtml}
                            </div>

                            <div class="pt-2 border-top border-subtle mt-2 text-muted-custom fs-micro">
                                ${tac.fuente || ''}
                            </div>
                        </div>
                    </div>`;
                }).join('');
            }
        }
    }

    // =========================================================================
    // 6. FUNCIÓN NÚCLEO DE FILTRADO Y ACTUALIZACIÓN DE LA CURVA
    // =========================================================================
    function aplicarFiltrosYActualizar() {
        let visibles = puntosOriginales.filter(p => periodosSeleccionados.has(p.periodo));

        if (filtroRango === 'ultimos4' || filtroRango === 'ultimos3') {
            visibles = visibles.slice(-4);
        } else if (filtroRango === 'ultimos8' || filtroRango === 'ultimos5') {
            visibles = visibles.slice(-8);
        }

        if (soloAlertas) {
            visibles = visibles.filter(p => p.score_prediccion > 35 || p.score_observado > 35);
        }

        puntosVisiblesActuales = visibles;

        if (visibles.length === 0) {
            activeIdxActual = -1;
            destIdxActual = -1;
            puntoActivoActual = null;
            esActualArr = [];
            if (mensajeSinPeriodos) mensajeSinPeriodos.classList.remove('d-none');
            canvasChart.style.opacity = '0.15';
            chartInstance.data.labels = [];
            chartInstance.data.datasets[0].data = [];
            chartInstance.data.datasets[1].data = [];
            chartInstance.update();

            if (badgeActivos) badgeActivos.textContent = `${periodosSeleccionados.size}/${periodosUnicos.length}`;
            if (contadorPuntos) contadorPuntos.textContent = `0 de ${puntosOriginales.length} trimestres`;
            if (puntosFooter) puntosFooter.textContent = '0';
            if (btnRestablecerFiltros) btnRestablecerFiltros.classList.remove('d-none');
            return;
        }

        if (mensajeSinPeriodos) mensajeSinPeriodos.classList.add('d-none');
        canvasChart.style.opacity = '1';

        const M = visibles.length;

        // Determinar índice del período activo dentro de los visibles (sin mutar puntosOriginales)
        let activeIdx = visibles.findIndex(p => p.es_actual);
        if (activeIdx === -1) {
            activeIdx = M - 1;
        }
        const puntoActivo = visibles[activeIdx];

        // Etiquetas del eje X: todas las visibles + la proyección del último período
        const lastPunto = visibles[M - 1];
        const nextFuturoLabel = lastPunto.periodo_proyectado || periodoProyectadoLabel;
        const newLabels = visibles.map(p => p.label).concat([nextFuturoLabel]);

        // Dataset 0: Datos Observados (longitud M + 1, con null al final)
        const newObservados = visibles.map(p => p.score_observado).concat([null]);

        // Dataset 1: Tramo proyectado dinámico que SALE del período activo hacia su trimestre siguiente (+90 días)
        const newProyectado = new Array(M + 1).fill(null);
        let destIdx = (activeIdx < M - 1) ? (activeIdx + 1) : M;
        newProyectado[activeIdx] = puntoActivo.score_observado;
        newProyectado[destIdx] = puntoActivo.score_prediccion;

        activeIdxActual = activeIdx;
        destIdxActual = destIdx;
        puntoActivoActual = puntoActivo;

        esActualArr = visibles.map((_, idx) => idx === activeIdx).concat([false]);

        const colorActivoSem = getColorSemaforo(puntoActivo.score_prediccion);
        colorProyeccionActual = colorActivoSem;
        if (indicadorLeyendaProyeccion) {
            indicadorLeyendaProyeccion.style.borderTopColor = colorActivoSem.border;
        }

        // Styling Dataset 0 (Observados)
        const obsPointRadii = visibles.map((_, idx) => idx === activeIdx ? 7.5 : 5.5).concat([0]);
        const obsPointHoverRadii = visibles.map((_, idx) => idx === activeIdx ? 10 : 8).concat([0]);
        const obsPointBorders = visibles.map((_, idx) => idx === activeIdx ? '#0f172a' : '#ffffff').concat(['transparent']);
        const obsPointBorderWidths = visibles.map((_, idx) => idx === activeIdx ? 3 : 2).concat([0]);
        const obsPointBg = visibles.map(() => '#2563eb').concat(['transparent']);

        // Styling Dataset 1 (Proyección a 90 días)
        const projPointRadii = new Array(M + 1).fill(0);
        projPointRadii[activeIdx] = visibilidadSeries.observados ? 0 : 4;
        projPointRadii[destIdx] = 9;
        const projPointHoverRadii = new Array(M + 1).fill(0);
        projPointHoverRadii[activeIdx] = visibilidadSeries.observados ? 0 : 6;
        projPointHoverRadii[destIdx] = 12;
        const projPointHitRadii = new Array(M + 1).fill(0);
        projPointHitRadii[activeIdx] = visibilidadSeries.observados ? 0 : 8;
        projPointHitRadii[destIdx] = 12;
        const projPointBg = new Array(M + 1).fill(colorActivoSem.border);
        projPointBg[activeIdx] = '#ffffff';

        chartInstance.data.labels = newLabels;

        // Dataset 0
        chartInstance.data.datasets[0].data = newObservados;
        chartInstance.data.datasets[0].pointRadius = obsPointRadii;
        chartInstance.data.datasets[0].pointHoverRadius = obsPointHoverRadii;
        chartInstance.data.datasets[0].pointBorderColor = obsPointBorders;
        chartInstance.data.datasets[0].pointBorderWidth = obsPointBorderWidths;
        chartInstance.data.datasets[0].pointBackgroundColor = obsPointBg;

        // Dataset 1
        chartInstance.data.datasets[1].data = newProyectado;
        chartInstance.data.datasets[1].borderColor = colorActivoSem.border;
        chartInstance.data.datasets[1].pointRadius = projPointRadii;
        chartInstance.data.datasets[1].pointHoverRadius = projPointHoverRadii;
        chartInstance.data.datasets[1].pointHitRadius = projPointHitRadii;
        chartInstance.data.datasets[1].pointBackgroundColor = projPointBg;

        // Respetar visibilidad elegida por el usuario
        chartInstance.setDatasetVisibility(0, visibilidadSeries.observados);
        chartInstance.setDatasetVisibility(1, visibilidadSeries.proyeccion);

        chartInstance.update();

        // Actualizar Cabecera de Horizonte y Sección de Recomendaciones con datos del período activo
        actualizarCabeceraHorizonte(puntoActivo, activeIdx, visibles);
        actualizarSeccionRecomendaciones(puntoActivo);

        // Actualizar contadores
        if (badgeActivos) {
            badgeActivos.textContent = `${periodosSeleccionados.size}/${periodosUnicos.length}`;
        }
        if (contadorPuntos) {
            contadorPuntos.textContent = `${visibles.length} de ${puntosOriginales.length} trimestres`;
        }
        if (puntosFooter) {
            puntosFooter.textContent = visibles.length;
        }
        if (totalFooter) {
            totalFooter.textContent = puntosOriginales.length;
        }

        const filtrosPersonalizados = (
            periodosSeleccionados.size !== periodosUnicos.length ||
            filtroRango !== 'todos' ||
            soloAlertas ||
            !visibilidadSeries.observados ||
            !visibilidadSeries.proyeccion
        );
        if (btnRestablecerFiltros) {
            btnRestablecerFiltros.classList.toggle('d-none', !filtrosPersonalizados);
        }
    }

    // Manejo de botones de rango
    function setRangoActivo(rango) {
        filtroRango = rango;
        [btnRangoTodos, btnRangoUltimos4, btnRangoUltimos8].forEach(btn => {
            if (btn) btn.classList.remove('active');
        });
        if (rango === 'todos' && btnRangoTodos) btnRangoTodos.classList.add('active');
        if ((rango === 'ultimos4' || rango === 'ultimos3') && btnRangoUltimos4) btnRangoUltimos4.classList.add('active');
        if ((rango === 'ultimos8' || rango === 'ultimos5') && btnRangoUltimos8) btnRangoUltimos8.classList.add('active');
    }

    if (btnMarcarTodos) {
        btnMarcarTodos.addEventListener('click', function () {
            periodosSeleccionados = new Set(periodosUnicos);
            document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = true; });
            visibilidadSeries.observados = true;
            visibilidadSeries.proyeccion = true;
            actualizarBotonesVisibilidad();
            setRangoActivo('todos');
            aplicarFiltrosYActualizar();
        });
    }

    if (btnDesmarcarTodos) {
        btnDesmarcarTodos.addEventListener('click', function () {
            periodosSeleccionados.clear();
            document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = false; });
            setRangoActivo('personalizado');
            aplicarFiltrosYActualizar();
        });
    }

    if (btnRangoTodos) {
        btnRangoTodos.addEventListener('click', function () {
            periodosSeleccionados = new Set(periodosUnicos);
            document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = true; });
            soloAlertas = false;
            if (btnFiltroAlertas) btnFiltroAlertas.classList.remove('active', 'btn-warning', 'text-white');

            // Restablecer todas las series a visibles
            visibilidadSeries.observados = true;
            visibilidadSeries.proyeccion = true;
            actualizarBotonesVisibilidad();

            setRangoActivo('todos');
            aplicarFiltrosYActualizar();
            try {
                const url = new URL(window.location.href);
                if (url.searchParams.has('periodo')) {
                    url.searchParams.delete('periodo');
                    window.history.replaceState(null, '', url.toString());
                }
            } catch (e) {}
        });
    }

    if (btnRangoUltimos4) {
        btnRangoUltimos4.addEventListener('click', function () {
            periodosSeleccionados = new Set(periodosUnicos);
            document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = true; });
            setRangoActivo('ultimos4');
            aplicarFiltrosYActualizar();
        });
    }

    if (btnRangoUltimos8) {
        btnRangoUltimos8.addEventListener('click', function () {
            periodosSeleccionados = new Set(periodosUnicos);
            document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = true; });
            setRangoActivo('ultimos8');
            aplicarFiltrosYActualizar();
        });
    }

    if (btnFiltroAlertas) {
        btnFiltroAlertas.addEventListener('click', function () {
            soloAlertas = !soloAlertas;
            this.classList.toggle('active', soloAlertas);
            this.classList.toggle('btn-warning', soloAlertas);
            this.classList.toggle('text-white', soloAlertas);
            aplicarFiltrosYActualizar();
        });
    }

    function restablecerTodo() {
        periodosSeleccionados = new Set(periodosUnicos);
        soloAlertas = false;
        if (btnFiltroAlertas) btnFiltroAlertas.classList.remove('active', 'btn-warning', 'text-white');
        document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = true; });

        // Restablecer visibilidad a los valores predeterminados
        visibilidadSeries.observados = true;
        visibilidadSeries.proyeccion = true;
        actualizarBotonesVisibilidad();

        setRangoActivo('todos');
        aplicarFiltrosYActualizar();
        try {
            const url = new URL(window.location.href);
            if (url.searchParams.has('periodo')) {
                url.searchParams.delete('periodo');
                window.history.replaceState(null, '', url.toString());
            }
        } catch (e) {}
    }

    if (btnRestablecerFiltros) {
        btnRestablecerFiltros.addEventListener('click', restablecerTodo);
    }
    if (btnRestablecerDesdeMensaje) {
        btnRestablecerDesdeMensaje.addEventListener('click', restablecerTodo);
    }

    // Inicialización de la barra de controles y datos del gráfico
    actualizarBotonesVisibilidad();
    renderizarCheckboxesPeriodos();
    aplicarFiltrosYActualizar();
});
</script>

