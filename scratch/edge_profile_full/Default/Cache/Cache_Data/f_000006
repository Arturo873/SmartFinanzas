<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Alternar visibilidad de contraseña
        const toggleButtons = document.querySelectorAll('.toggle-password');
        toggleButtons.forEach(button => {
            button.addEventListener('click', function () {
                const targetId = this.getAttribute('data-target');
                const targetInput = document.getElementById(targetId);
                const icon = this.querySelector('i');
                if (!targetInput) return;

                if (targetInput.type === 'password') {
                    targetInput.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    targetInput.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });

        // Sincronización de Términos y Condiciones (Formulario vs Modal)
        const checkPrincipal = document.getElementById('checkTerminosRegistro');
        const checkModal = document.getElementById('checkModalRegistro');
        const btnAceptarModal = document.getElementById('btnAceptarModalRegistro');
        const modalEl = document.getElementById('modalTerminosRegistro');
        let aceptadoDesdeModal = false;

        // Al presionar el check principal en el formulario, desplegar automáticamente el modal
        if (checkPrincipal && modalEl) {
            checkPrincipal.addEventListener('click', function (e) {
                if (!aceptadoDesdeModal) {
                    e.preventDefault();
                    this.checked = false;
                    actualizarEstadoBtnRegistro();
                    if (typeof bootstrap !== 'undefined') {
                        const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
                        modalInstance.show();
                    }
                } else {
                    // Si ya estaba aceptado y el usuario hace clic para desmarcarlo:
                    aceptadoDesdeModal = false;
                    this.checked = false;
                    actualizarEstadoBtnRegistro();
                }
            });
        }

        // Al abrir el modal, la casilla SIEMPRE debe estar desmarcada y el botón desactivado
        if (modalEl) {
            modalEl.addEventListener('show.bs.modal', function () {
                if (checkModal) {
                    checkModal.checked = false;
                }
                if (btnAceptarModal) {
                    btnAceptarModal.disabled = true;
                }
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                if (!aceptadoDesdeModal && checkPrincipal) {
                    checkPrincipal.checked = false;
                    actualizarEstadoBtnRegistro();
                }
            });
        }

        if (checkModal && btnAceptarModal) {
            checkModal.addEventListener('change', function () {
                btnAceptarModal.disabled = !this.checked;
            });

            btnAceptarModal.addEventListener('click', function () {
                aceptadoDesdeModal = true;
                if (checkPrincipal) {
                    checkPrincipal.checked = true;
                    actualizarEstadoBtnRegistro();
                }
                if (modalEl && typeof bootstrap !== 'undefined') {
                    const modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    modalInstance.hide();
                }
            });
        }

        // Bloqueo estricto del botón de envío si el check no está marcado
        const btnSubmitRegistro = document.getElementById('btnSubmitRegistro');
        const cardCheckRegistro = document.getElementById('cardCheckRegistro');
        const errorCheckRegistro = document.getElementById('errorCheckRegistro');
        const formRegistro = document.querySelector('form');

        function actualizarEstadoBtnRegistro() {
            if (!btnSubmitRegistro) return;
            const marcado = checkPrincipal && checkPrincipal.checked;
            btnSubmitRegistro.disabled = !marcado;
            if (marcado) {
                if (checkPrincipal) checkPrincipal.classList.remove('is-invalid');
                if (cardCheckRegistro) cardCheckRegistro.classList.remove('border', 'border-danger');
                if (errorCheckRegistro) errorCheckRegistro.classList.add('d-none');
            }
        }

        if (checkPrincipal) {
            checkPrincipal.addEventListener('change', actualizarEstadoBtnRegistro);
            actualizarEstadoBtnRegistro();
        }

        if (formRegistro) {
            formRegistro.addEventListener('submit', function (e) {
                if (checkPrincipal && !checkPrincipal.checked) {
                    e.preventDefault();
                    e.stopPropagation();
                    checkPrincipal.focus();
                    checkPrincipal.classList.add('is-invalid');
                    if (cardCheckRegistro) cardCheckRegistro.classList.add('border', 'border-danger');
                    if (errorCheckRegistro) errorCheckRegistro.classList.remove('d-none');
                    return false;
                }
            });
        }

        // ======================================================================
        // CONTROL DESLIZADOR INTERACTIVO DE EMPRESAS
        // ======================================================================
        const empresasDataEl = document.getElementById('empresasData');
        const deslizador = document.getElementById('deslizadorEmpresa');
        const btnPrev = document.getElementById('btnEmpresaPrev');
        const btnNext = document.getElementById('btnEmpresaNext');
        const empresaNombre = document.getElementById('empresaNombre');
        const empresaRut = document.getElementById('empresaRut');
        const empresaIndice = document.getElementById('empresaIndiceActual');
        const progressBar = document.getElementById('empresaProgressBar');
        const deslizadorHint = document.getElementById('deslizadorHint');
        const empresaContainer = document.getElementById('empresaDisplayContainer');
        const selectEmpresa = document.getElementById('id_company');

        if (empresasDataEl && deslizador && selectEmpresa) {
            let empresas = [];
            try {
                empresas = JSON.parse(empresasDataEl.textContent.trim());
            } catch (e) {
                console.error("Error parseando listado de empresas:", e);
            }

            if (empresas.length > 0) {
                function actualizarEmpresa(index, animate) {
                    index = Math.max(0, Math.min(empresas.length - 1, parseInt(index) || 0));
                    const emp = empresas[index];
                    if (!emp) return;

                    if (animate && empresaContainer) {
                        empresaContainer.style.opacity = '0.3';
                        setTimeout(() => {
                            empresaNombre.textContent = emp.nombre;
                            empresaRut.textContent = emp.rut ? `RUT: ${emp.rut}` : 'RUT: No informado';
                            empresaContainer.style.opacity = '1';
                        }, 90);
                    } else {
                        empresaNombre.textContent = emp.nombre;
                        empresaRut.textContent = emp.rut ? `RUT: ${emp.rut}` : 'RUT: No informado';
                    }

                    if (empresaIndice) {
                        empresaIndice.textContent = (index + 1);
                    }
                    if (deslizadorHint) {
                        deslizadorHint.textContent = emp.nombre;
                    }
                    if (progressBar) {
                        const pct = ((index + 1) / empresas.length) * 100;
                        progressBar.style.width = `${pct}%`;
                    }

                    deslizador.value = index;

                    // Sincronizar el select original de Django para el POST
                    selectEmpresa.value = emp.id;

                    // Habilitar/deshabilitar flechas en los extremos
                    if (btnPrev) btnPrev.disabled = (index === 0);
                    if (btnNext) btnNext.disabled = (index === empresas.length - 1);
                }

                // Detectar si ya venía un valor preseleccionado
                let initialIndex = 0;
                const valorActual = selectEmpresa.value;
                if (valorActual) {
                    const foundIdx = empresas.findIndex(e => String(e.id) === String(valorActual));
                    if (foundIdx !== -1) {
                        initialIndex = foundIdx;
                    }
                }

                // Inicializar visualización
                actualizarEmpresa(initialIndex, false);

                // Eventos del Input Range Deslizador
                deslizador.addEventListener('input', function () {
                    actualizarEmpresa(this.value, false);
                });
                deslizador.addEventListener('change', function () {
                    actualizarEmpresa(this.value, true);
                });

                // Flechas de navegación lateral
                if (btnPrev) {
                    btnPrev.addEventListener('click', function () {
                        const cur = parseInt(deslizador.value) || 0;
                        if (cur > 0) {
                            actualizarEmpresa(cur - 1, true);
                        }
                    });
                }

                if (btnNext) {
                    btnNext.addEventListener('click', function () {
                        const cur = parseInt(deslizador.value) || 0;
                        if (cur < empresas.length - 1) {
                            actualizarEmpresa(cur + 1, true);
                        }
                    });
                }

                // Navegación por teclado (Flechas izquierda / derecha)
                deslizador.addEventListener('keydown', function (e) {
                    const cur = parseInt(deslizador.value) || 0;
                    if (e.key === 'ArrowLeft' && cur > 0) {
                        actualizarEmpresa(cur - 1, true);
                    } else if (e.key === 'ArrowRight' && cur < empresas.length - 1) {
                        actualizarEmpresa(cur + 1, true);
                    }
                });
            }
        }
    });
</script>

</body>
</html>
