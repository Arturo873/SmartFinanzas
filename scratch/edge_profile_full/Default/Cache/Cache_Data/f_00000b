<!-- Reactividad controlada en Vanilla JS: las alertas de descuadre y justificación solo se activan al confirmar el cierre -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    const inputArqueo = document.getElementById('id_counted_total');
    const displayEfectivoEsperado = document.getElementById('displayEfectivoEsperado');
    const displayTotalSistema = document.getElementById('displayTotalSistema');
    const panelDiferencia = document.getElementById('panelDiferencia');
    const iconoDiferencia = document.getElementById('iconoDiferencia');
    const textoDiferencia = document.getElementById('textoDiferencia');
    const subtextoDiferencia = document.getElementById('subtextoDiferencia');
    const contenedorJustificacion = document.getElementById('contenedorJustificacion');
    const textareaJustificacion = document.getElementById('id_justification');
    const formCierre = document.getElementById('formCierre');

    // La cuadratura física (Opción A) se realiza estrictamente contra el Efectivo Físico en Gaveta
    const efectivoEsperado = parseFloat(displayEfectivoEsperado ? displayEfectivoEsperado.getAttribute('data-valor') : 0) || 0;
    const totalSistema = parseFloat(displayTotalSistema ? displayTotalSistema.getAttribute('data-valor') : 0) || 0;
    const tieneErroresServidor = false;

    function formatearMonto(valor) {
        return '$' + Math.abs(Math.round(valor)).toLocaleString('es-CL');
    }

    // Bandera para saber si el usuario ya intentó confirmar y se le detectó descuadre
    let intentoConfirmarConDescuadre = tieneErroresServidor;

    function evaluarCuadratura(alConfirmar = false) {
        const valorTexto = inputArqueo ? inputArqueo.value.trim() : '';

        if (valorTexto === '') {
            panelDiferencia.className = 'alert alert-secondary py-3 px-3 shadow-sm d-flex align-items-center gap-3';
            iconoDiferencia.innerHTML = '<i class="bi bi-dash-circle"></i>';
            textoDiferencia.textContent = 'Ingrese el conteo de efectivo físico para calcular la cuadratura.';
            subtextoDiferencia.textContent = `Comparación automática contra el Efectivo en Gaveta (${formatearMonto(efectivoEsperado)}).`;
            
            // Ocultar justificación si no hay errores de servidor ni justificación previa
            if (!tieneErroresServidor && (!textareaJustificacion || textareaJustificacion.value.trim() === '')) {
                contenedorJustificacion.classList.add('d-none');
                textareaJustificacion.removeAttribute('required');
            }
            return;
        }

        const arqueoFisico = parseFloat(valorTexto) || 0;
        const diferencia = arqueoFisico - efectivoEsperado;

        // Tolerancia contable (CLP sin centavos): diferencia menor a $1 peso se considera exactamente cuadrada
        if (Math.abs(diferencia) < 1.0) {
            // CAJA EXACTAMENTE CUADRADA
            intentoConfirmarConDescuadre = false;
            panelDiferencia.className = 'alert alert-success py-3 px-3 shadow-sm d-flex align-items-center gap-3';
            iconoDiferencia.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i>';
            textoDiferencia.innerHTML = '<strong>Caja Cuadrada Perfecta</strong>';
            subtextoDiferencia.textContent = 'El dinero físico coincide con el efectivo esperado en gaveta ($0 de descuadre).';
            
            // Ocultar campo de justificación y desmarcar requerimiento
            contenedorJustificacion.classList.add('d-none');
            textareaJustificacion.removeAttribute('required');
        } else {
            // Hay descuadre físico en gaveta
            // Solo mostramos la alarma y el campo de justificación SI el usuario le dio a "Confirmar y Cerrar",
            // o si el formulario ya vino con errores desde el servidor, o si el usuario ya tiene justificación escrita
            const tieneJustificacionEscrita = textareaJustificacion && textareaJustificacion.value.trim() !== '';

            if (alConfirmar || tieneErroresServidor || (intentoConfirmarConDescuadre && tieneJustificacionEscrita)) {
                intentoConfirmarConDescuadre = true;
                const esFaltante = diferencia < 0;
                const tipo = esFaltante ? 'Faltante en Gaveta' : 'Sobrante en Gaveta';
                const signo = esFaltante ? '-' : '+';
                const colorClase = esFaltante ? 'alert-danger' : 'alert-warning';
                const iconoColor = esFaltante ? 'text-danger' : 'text-warning';

                panelDiferencia.className = `alert ${colorClase} py-3 px-3 shadow-sm d-flex align-items-center gap-3`;
                iconoDiferencia.innerHTML = `<i class="bi bi-exclamation-triangle-fill ${iconoColor}"></i>`;
                textoDiferencia.innerHTML = `<strong>${tipo}: ${signo}${formatearMonto(diferencia)}</strong>`;
                subtextoDiferencia.textContent = `Existe una discrepancia con el efectivo esperado en gaveta (${formatearMonto(efectivoEsperado)}). Ingrese la justificación obligatoria o ajuste el conteo físico.`;

                // Mostrar campo de justificación y volverlo required en el DOM
                contenedorJustificacion.classList.remove('d-none');
                textareaJustificacion.setAttribute('required', 'required');
            } else {
                // Mientras el usuario escribe antes de confirmar, mantener el estado neutral sin alarmas invasivas
                panelDiferencia.className = 'alert alert-light border py-3 px-3 shadow-sm d-flex align-items-center gap-3';
                iconoDiferencia.innerHTML = '<i class="bi bi-calculator text-primary"></i>';
                textoDiferencia.textContent = `Efectivo contado: ${formatearMonto(arqueoFisico)}`;
                subtextoDiferencia.textContent = `Efectivo esperado en gaveta: ${formatearMonto(efectivoEsperado)}. Presione «Confirmar y Cerrar Caja» para validar el cuadre.`;

                // NO mostrar la justificación todavía si no hay texto ni errores
                if (!tieneJustificacionEscrita && !tieneErroresServidor) {
                    contenedorJustificacion.classList.add('d-none');
                    textareaJustificacion.removeAttribute('required');
                }
            }
        }
    }

    if (inputArqueo) {
        inputArqueo.addEventListener('input', function () {
            // Si el usuario edita el arqueo para cuadrarlo y no tiene texto de justificación,
            // desactivamos la alarma roja hasta que vuelva a pulsar confirmar
            if (textareaJustificacion && textareaJustificacion.value.trim() === '') {
                intentoConfirmarConDescuadre = false;
            }
            evaluarCuadratura(false);
        });
        evaluarCuadratura(false);
    }

    if (textareaJustificacion) {
        textareaJustificacion.addEventListener('input', function () {
            if (this.value.trim() !== '') {
                intentoConfirmarConDescuadre = true;
            }
        });
    }

    // Sincronización de Términos de Arqueo y Cierre (Formulario vs Modal)
    const checkPrincipalCierre = document.getElementById('checkTerminosCierre');
    const checkModalCierre = document.getElementById('checkModalCierre');
    const btnAceptarModalCierre = document.getElementById('btnAceptarModalCierre');
    const modalElCierre = document.getElementById('modalTerminosCierre');

    // Al abrir el modal, la casilla SIEMPRE debe estar desmarcada y el botón desactivado
    if (modalElCierre) {
        modalElCierre.addEventListener('show.bs.modal', function () {
            if (checkModalCierre) {
                checkModalCierre.checked = false;
            }
            if (btnAceptarModalCierre) {
                btnAceptarModalCierre.disabled = true;
            }
        });
    }

    if (checkModalCierre && btnAceptarModalCierre) {
        checkModalCierre.addEventListener('change', function () {
            btnAceptarModalCierre.disabled = !this.checked;
        });

        btnAceptarModalCierre.addEventListener('click', function () {
            if (checkPrincipalCierre) {
                checkPrincipalCierre.checked = true;
                checkPrincipalCierre.dispatchEvent(new Event('change'));
            }
            if (modalElCierre && typeof bootstrap !== 'undefined') {
                const modalInstance = bootstrap.Modal.getInstance(modalElCierre) || new bootstrap.Modal(modalElCierre);
                modalInstance.hide();
            }
        });
    }

    // Bloqueo dinámico del botón de confirmación si el check no está marcado
    const btnConfirmarCierre = document.getElementById('btnConfirmarCierre');
    const cardCheckCierre = document.getElementById('cardCheckCierre');
    const errorCheckCierre = document.getElementById('errorCheckCierre');

    function actualizarEstadoBtnCierre() {
        if (!btnConfirmarCierre) return;
        const marcado = checkPrincipalCierre && checkPrincipalCierre.checked;
        btnConfirmarCierre.disabled = !marcado;
        if (marcado) {
            if (checkPrincipalCierre) checkPrincipalCierre.classList.remove('is-invalid');
            if (cardCheckCierre) cardCheckCierre.classList.remove('border', 'border-danger');
            if (errorCheckCierre) errorCheckCierre.classList.add('d-none');
        }
    }

    if (checkPrincipalCierre) {
        checkPrincipalCierre.addEventListener('change', actualizarEstadoBtnCierre);
        actualizarEstadoBtnCierre();
    }

    if (formCierre) {
        formCierre.addEventListener('submit', function (e) {
            // 1. Validar certificación y términos legales
            if (checkPrincipalCierre && !checkPrincipalCierre.checked) {
                e.preventDefault();
                alert('Debe certificar la exactitud del arqueo físico y aceptar los Términos Legales de Rendición de Fondos y Cierre Contable para continuar.');
                checkPrincipalCierre.focus();
                return false;
            }

            // 2. Validar que se haya ingresado el monto de arqueo
            const valorTexto = inputArqueo ? inputArqueo.value.trim() : '';
            if (valorTexto === '') {
                e.preventDefault();
                alert('Debe ingresar el monto de efectivo físico contado en la gaveta.');
                if (inputArqueo) inputArqueo.focus();
                return false;
            }

            const arqueoFisico = parseFloat(valorTexto) || 0;
            const diferencia = arqueoFisico - efectivoEsperado;

            // 3. Si hay descuadre en gaveta y aún no hay justificación escrita, detener y mostrar alarma para cuadrarlo
            if (Math.abs(diferencia) >= 1.0) {
                const justificacionTexto = textareaJustificacion ? textareaJustificacion.value.trim() : '';
                if (justificacionTexto === '') {
                    e.preventDefault(); // Detener el envío y devolver al cierre para cuadrarlo
                    evaluarCuadratura(true); // Activa la visualización del faltante/sobrante y muestra el campo de justificación
                    panelDiferencia.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    if (textareaJustificacion) textareaJustificacion.focus();
                    return false;
                }
            }
        });
    }
});
</script>

