    <!-- Script para alternar el Sidebar en dispositivos móviles e inicializar Tooltips -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Inicialización global de Tooltips Bootstrap
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl);
            });

            const sidebar = document.getElementById('sidebarNav');
            const toggleBtn = document.getElementById('sidebarToggle');
            const backdrop = document.getElementById('sidebarBackdrop');

            if (toggleBtn && sidebar && backdrop) {
                function toggleSidebar() {
                    sidebar.classList.toggle('show');
                    backdrop.classList.toggle('show');
                }

                toggleBtn.addEventListener('click', toggleSidebar);
                backdrop.addEventListener('click', toggleSidebar);
            }

            // Manejador del botón y formulario "Ejecutar Análisis" (RF-11)
            const formsEjecutar = document.querySelectorAll('.form-ejecutar-analisis');
            const modalCargaEl = document.getElementById('modalCargaAnalisis');
            let modalCargaInstance = null;

            formsEjecutar.forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    // Deshabilitar botón para prevenir doble clic y mostrar spinner en botón
                    const submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Ejecutando Análisis...';
                    }

                    // Cerrar cualquier modal abierto (ej. modal de advertencia de outliers)
                    const modalesAbiertos = document.querySelectorAll('.modal.show');
                    modalesAbiertos.forEach(function (m) {
                        const inst = bootstrap.Modal.getInstance(m);
                        if (inst) inst.hide();
                    });

                    // Mostrar barra / spinner de carga en modal persistente
                    if (modalCargaEl && typeof bootstrap !== 'undefined') {
                        if (!modalCargaInstance) {
                            modalCargaInstance = new bootstrap.Modal(modalCargaEl, { backdrop: 'static', keyboard: false });
                        }
                        modalCargaInstance.show();
                    }
                });
            });
        });
    </script>

    
<!-- Reactividad pura en Vanilla JS para mitigar la ceguera de liquidez -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    const inputBruto = document.getElementById('id_gross_total');
    const inputDescuento = document.getElementById('id_discount_amount');
    const selectMetodo = document.getElementById('id_payment_method');
    const textoIngresoReal = document.getElementById('textoIngresoReal');
    const textoComision = document.getElementById('textoComision');
    const panelLiquidez = document.getElementById('panelLiquidez');

    function formatearDinero(valor) {
        return new Intl.NumberFormat('es-CL', {
            style: 'currency',
            currency: 'CLP',
            maximumFractionDigits: 0
        }).format(valor);
    }

    function recalcularLiquidez() {
        const bruto = parseFloat(inputBruto.value) || 0;
        const descuento = parseFloat(inputDescuento.value) || 0;

        // Leer la opción seleccionada y su atributo data-comision
        const opcionSeleccionada = selectMetodo.options[selectMetodo.selectedIndex];
        const porcentajeComision = opcionSeleccionada ? parseFloat(opcionSeleccionada.getAttribute('data-comision')) || 0 : 0;

        // Validaciones en caliente
        if (bruto <= 0) {
            textoIngresoReal.textContent = 'Ingreso Real Estimado: $0';
            textoComision.textContent = '(Comisión deducida: $0)';
            panelLiquidez.className = 'alert alert-info shadow-sm d-flex align-items-center gap-3 py-3 px-3 my-4';
            return;
        }

        if (descuento >= bruto) {
            textoIngresoReal.innerHTML = '<span class="text-danger fw-bold">El descuento no puede superar o igualar el total bruto.</span>';
            textoComision.textContent = '(Operación Inválida)';
            panelLiquidez.className = 'alert alert-warning shadow-sm d-flex align-items-center gap-3 py-3 px-3 my-4';
            return;
        }

        const totalCobrado = bruto - descuento;
        const comisionDeducida = totalCobrado * (porcentajeComision / 100);
        const ingresoReal = totalCobrado - comisionDeducida;

        textoIngresoReal.textContent = `Ingreso Real Estimado: ${formatearDinero(ingresoReal)}`;
        textoComision.textContent = `(Comisión deducida: ${formatearDinero(comisionDeducida)} [${porcentajeComision}% adquirencia])`;

        panelLiquidez.className = 'alert alert-success shadow-sm d-flex align-items-center gap-3 py-3 px-3 my-4';
    }

    // Escuchar eventos
    if (inputBruto) inputBruto.addEventListener('input', recalcularLiquidez);
    if (inputDescuento) inputDescuento.addEventListener('input', recalcularLiquidez);
    if (selectMetodo) selectMetodo.addEventListener('change', recalcularLiquidez);

    // Ejecutar al cargar la página
    recalcularLiquidez();
});
</script>

