<!-- Curva de Tendencia y Control de Períodos Históricos (RF-04) -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    // Control de Aceptación de Términos para Descarga de Informe Ejecutivo
    const checkModalML = document.getElementById('checkModalML');
    const btnDescargarPdf = document.getElementById('btnDescargarPdfModal');
    const modalInformeEl = document.getElementById('modalTerminosInforme');

    // Al abrir el modal, la casilla SIEMPRE debe estar desmarcada y el botón desactivado
    if (modalInformeEl) {
        modalInformeEl.addEventListener('show.bs.modal', function () {
            if (checkModalML) {
                checkModalML.checked = false;
            }
            if (btnDescargarPdf) {
                btnDescargarPdf.classList.add('disabled');
            }
        });
    }

    if (checkModalML && btnDescargarPdf) {
        checkModalML.addEventListener('change', function () {
            if (this.checked) {
                btnDescargarPdf.classList.remove('disabled');
            } else {
                btnDescargarPdf.classList.add('disabled');
            }
        });

        btnDescargarPdf.addEventListener('click', function (e) {
            if (!checkModalML.checked) {
                e.preventDefault();
                return;
            }
            setTimeout(function () {
                if (modalInformeEl && typeof bootstrap !== 'undefined') {
                    const modalInst = bootstrap.Modal.getInstance(modalInformeEl) || new bootstrap.Modal(modalInformeEl);
                    modalInst.hide();
                }
            }, 500);
        });
    }

    // Inicialización de Tooltips de Bootstrap 5 para métricas y explicabilidad SHAP
    if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.forEach(function (tooltipTriggerEl) {
            new bootstrap.Tooltip(tooltipTriggerEl);
        });
    }

    const ctx = document.getElementById('riesgoChart');
    if (!ctx) return;

    // 1. Carga de datos parseados desde el backend
    const fechasElem = document.getElementById('chart-fechas-raw');
    const scoresElem = document.getElementById('chart-scores-raw');
    const actualElem = document.getElementById('chart-actual-raw');
    const puntosElem = document.getElementById('timeline-puntos-raw') || document.getElementById('chart-puntos-raw');
    const puntosFiltradosElem = document.getElementById('chart-puntos-raw');
    const observadoElem = document.getElementById('timeline-observado-raw');
    const prediccionesElem = document.getElementById('timeline-predicciones-raw');
    const labelsElem = document.getElementById('timeline-labels-raw');

    let fechas = [];
    let scores = [];
    let esActual = [];
    let puntosRaw = [];
    let puntosFiltradosRaw = [];
    let timelineObservado = [];
    let timelinePredicciones = [];
    let timelineLabels = [];

    try {
        fechas = fechasElem ? JSON.parse(fechasElem.textContent || '[]') : [];
        scores = scoresElem ? JSON.parse(scoresElem.textContent || '[]') : [];
        esActual = actualElem ? JSON.parse(actualElem.textContent || '[]') : [];
        puntosRaw = puntosElem ? JSON.parse(puntosElem.textContent || '[]') : [];
        puntosFiltradosRaw = puntosFiltradosElem ? JSON.parse(puntosFiltradosElem.textContent || '[]') : [];
        timelineObservado = observadoElem ? JSON.parse(observadoElem.textContent || '[]') : [];
        timelinePredicciones = prediccionesElem ? JSON.parse(prediccionesElem.textContent || '[]') : [];
        timelineLabels = labelsElem ? JSON.parse(labelsElem.textContent || '[]') : [];
    } catch (e) {
        console.error('Error al parsear datos de tendencia:', e);
    }

    // =========================================================================
    // FUNCIÓN SIGMOIDE CALIBRADA: DE ALTMAN Z'' A PORCENTAJE DE RIESGO (0-100%)
    // =========================================================================
    function altmanZToRiskPercentage(zScore, patrimonioNeto = 1) {
        // Guarda contable: Si el patrimonio neto es negativo o cero -> Quiebra Técnica Inmediata
        if (patrimonioNeto <= 0) return 99.0;
        // P(Riesgo %) = 100.0 / (1.0 + exp(1.15 * (Z'' - 1.85)))
        const arg = Math.max(-35.0, Math.min(35.0, 1.15 * (zScore - 1.85)));
        const risk = 100.0 / (1.0 + Math.exp(arg));
        return parseFloat(Math.max(1.0, Math.min(99.0, risk)).toFixed(1));
    }

    // Normalizar puntos para manipulación y filtrado interactivo (RF-04)
    let puntosOriginales = [];
    if (puntosRaw && puntosRaw.length > 0) {
        puntosOriginales = puntosRaw.map((p, idx) => {
            const zScoreVal = typeof p.altman_z === 'number' ? p.altman_z : null;
            const patVal = typeof p.patrimonio_neto === 'number' ? p.patrimonio_neto : 1;
            let scObs = typeof p.score_observado === 'number' ? p.score_observado : null;
            if (scObs === null && zScoreVal !== null) {
                scObs = altmanZToRiskPercentage(zScoreVal, patVal);
            } else if (scObs === null) {
                scObs = typeof p.score === 'number' ? p.score : 35.0;
            }

            return {
                id: p.id || (idx + 1),
                periodo: p.periodo || `Periodo ${idx + 1}`,
                label: p.label || fechas[idx] || `Punto ${idx + 1}`,
                altman_z: zScoreVal,
                patrimonio_neto: patVal,
                score_observado: scObs,
                score_prediccion: typeof p.score_prediccion === 'number' ? p.score_prediccion : (typeof p.score === 'number' ? p.score : 35.0),
                score_ml_raw: p.score_ml_raw,
                score: typeof p.score === 'number' ? p.score : 35.0,
                nivel: p.nivel || (p.score > 70 ? 'Rojo' : (p.score > 35 ? 'Amarillo' : 'Verde')),
                nivel_observado: p.nivel_observado || (scObs > 70 ? 'Rojo' : (scObs > 35 ? 'Amarillo' : 'Verde')),
                periodo_proyectado: p.periodo_proyectado || `Q_{t+1}`,
                score_proyectado: typeof p.score_proyectado === 'number' ? p.score_proyectado : (typeof p.score === 'number' ? p.score : 35.0),
                es_actual: Boolean(p.es_actual !== undefined ? p.es_actual : esActual[idx])
            };
        });
    } else if (timelineObservado.length > 0 || scores.length > 0) {
        const obsList = timelineObservado.length > 0 ? timelineObservado : scores;
        puntosOriginales = obsList.map((s, idx) => {
            const predVal = (timelinePredicciones[idx] !== null && timelinePredicciones[idx] !== undefined) ? timelinePredicciones[idx] : (scores[idx] || s);
            return {
                id: idx + 1,
                periodo: fechas[idx] ? fechas[idx].split(' ')[0] : `P-${idx + 1}`,
                label: fechas[idx] || `Punto ${idx + 1}`,
                altman_z: null,
                patrimonio_neto: 1,
                score_observado: s,
                score_prediccion: predVal,
                score_ml_raw: null,
                score: predVal,
                nivel: predVal > 70 ? 'Rojo' : (predVal > 35 ? 'Amarillo' : 'Verde'),
                nivel_observado: s > 70 ? 'Rojo' : (s > 35 ? 'Amarillo' : 'Verde'),
                periodo_proyectado: 'Q_{t+1}',
                score_proyectado: predVal,
                es_actual: Boolean(esActual[idx])
            };
        });
    }

    // Si hay datos pero ninguno marcado como actual, marcar el último (más reciente)
    if (puntosOriginales.length > 0 && !puntosOriginales.some(p => p.es_actual)) {
        puntosOriginales[puntosOriginales.length - 1].es_actual = true;
    }

    // 2. Extraer períodos únicos disponibles en el historial
    const periodosUnicos = [];
    puntosOriginales.forEach(p => {
        if (!periodosUnicos.includes(p.periodo)) {
            periodosUnicos.push(p.periodo);
        }
    });

    // Estado reactivo de períodos seleccionados y filtros
    let periodosSeleccionados = new Set(periodosUnicos);
    let filtroRango = 'todos'; // 'todos' | 'ultimos4' | 'ultimos8' | 'personalizado'
    if (puntosFiltradosRaw && puntosFiltradosRaw.length > 0 && puntosFiltradosRaw.length < puntosOriginales.length) {
        const filtradosSet = new Set(puntosFiltradosRaw.map(p => p.periodo).filter(p => periodosUnicos.includes(p)));
        if (filtradosSet.size > 0) {
            periodosSeleccionados = filtradosSet;
            filtroRango = 'personalizado';
        }
    }
    let soloAlertas = false;
    let esActualArr = [];
