    function posicionarEnPeriodo(periodo, puntoId) {
        // 1. Inmediato (0ms): Actualizar estado de puntos y redibujar Chart.js
        puntosOriginales.forEach(p => {
            if (puntoId) {
                p.es_actual = (p.id === puntoId);
            } else {
                p.es_actual = (p.periodo === periodo);
            }
        });

        if (!periodosSeleccionados.has(periodo)) {
            periodosSeleccionados.add(periodo);
            const chk = document.querySelector(`.check-periodo-item[value="${periodo}"]`);
            if (chk) chk.checked = true;
        }

        renderizarCheckboxesPeriodos();
        aplicarFiltrosYActualizar();

        const puntoActivo = puntosOriginales.find(p => (puntoId ? p.id === puntoId : p.periodo === periodo));
        if (puntoActivo) {
            actualizarCardScore(puntoActivo.score, puntoActivo.nivel, puntoActivo.fecha_completa || puntoActivo.fecha_corta);
        }

        // 2. Actualizar URL con replaceState sin recargar la página
        try {
            const url = new URL(window.location.href);
            if (puntoActivo && puntoActivo.id) {
                url.searchParams.set('prediccion_id', puntoActivo.id);
            }
            url.searchParams.set('periodo', periodo);
            window.history.replaceState(null, '', url.toString());
        } catch (e) {}

        // 3. Carga asíncrona fluida (AJAX) para SHAP, Ratios y Estados Contables
        const targetId = (puntoActivo && puntoActivo.id) ? puntoActivo.id : puntoId;
        cargarDatosPeriodoAjax(targetId, periodo);
    }

    function cargarDatosPeriodoAjax(prediccionId, periodo) {
        if (abortController) {
            abortController.abort();
        }
        abortController = new AbortController();

        let query = '';
        if (prediccionId) query += `prediccion_id=${encodeURIComponent(prediccionId)}&`;
        if (periodo) query += `periodo=${encodeURIComponent(periodo)}&`;
        query += 'ajax=1';

        const url = `/dashboard/?${query}`;
        fetch(url, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            signal: abortController.signal
        })
        .then(response => {
            if (!response.ok) throw new Error('Error al obtener datos');
            return response.json();
        })
        .then(data => {
            if (data.status === 'ok') {
                actualizarCardScore(data.score, data.nivel, data.fecha_prediccion);
                actualizarBannerHistorico(data);
                actualizarShapCards(data.top_3_variables);
                actualizarRatiosSeccion(data);
                if (data.info_periodo) {
                    actualizarInfoPeriodo(data.info_periodo);
                }
                const btnPdf = document.getElementById('btnDescargarPdfModal');
                if (btnPdf && data.prediccion_id) {
                    btnPdf.href = `/dashboard/exportar-pdf/?prediccion_id=${data.prediccion_id}`;
                }
                if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                    const tooltipList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                    tooltipList.forEach(el => new bootstrap.Tooltip(el));
                }
            }
        })
        .catch(err => {
            if (err.name !== 'AbortError') {
                console.warn('Detalle de carga asíncrona:', err);
            }
        });
    }

    // Manejo visual de botones de rango
    function setRangoActivo(rango) {
        filtroRango = rango;
        [btnRangoTodos, btnRangoUltimos4, btnRangoUltimos8].forEach(btn => {
            if (btn) btn.classList.remove('active');
        });
        if (rango === 'todos' && btnRangoTodos) btnRangoTodos.classList.add('active');
        if ((rango === 'ultimos4' || rango === 'ultimos3') && btnRangoUltimos4) btnRangoUltimos4.classList.add('active');
        if ((rango === 'ultimos8' || rango === 'ultimos5') && btnRangoUltimos8) btnRangoUltimos8.classList.add('active');
    }

    // 7. Enlace de Eventos para la Interactividad del Usuario
    if (btnMarcarTodos) {
        btnMarcarTodos.addEventListener('click', function () {
            periodosSeleccionados = new Set(periodosUnicos);
            document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = true; });
            visibilidadSeries.observados = true;
            visibilidadSeries.proyeccion = true;
            actualizarBotonesVisibilidad();
            setRangoActivo('todos');
            aplicarFiltrosYActualizar();
        });
    }

    if (btnDesmarcarTodos) {
        btnDesmarcarTodos.addEventListener('click', function () {
            periodosSeleccionados.clear();
            document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = false; });
            setRangoActivo('personalizado');
            aplicarFiltrosYActualizar();
        });
    }

    if (btnRangoTodos) {
        btnRangoTodos.addEventListener('click', function () {
            periodosSeleccionados = new Set(periodosUnicos);
            document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = true; });
            soloAlertas = false;
            if (btnFiltroAlertas) btnFiltroAlertas.classList.remove('active', 'btn-warning', 'text-white');
            visibilidadSeries.observados = true;
            visibilidadSeries.proyeccion = true;
            actualizarBotonesVisibilidad();
            setRangoActivo('todos');
            aplicarFiltrosYActualizar();
            try {
                const url = new URL(window.location.href);
                if (url.searchParams.has('periodo')) {
                    url.searchParams.delete('periodo');
                    window.history.replaceState(null, '', url.toString());
                }
            } catch (e) {}
        });
    }

    if (btnRangoUltimos4) {
        btnRangoUltimos4.addEventListener('click', function () {
            periodosSeleccionados = new Set(periodosUnicos);
            document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = true; });
            setRangoActivo('ultimos4');
            aplicarFiltrosYActualizar();
        });
    }

    if (btnRangoUltimos8) {
        btnRangoUltimos8.addEventListener('click', function () {
            periodosSeleccionados = new Set(periodosUnicos);
            document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = true; });
            setRangoActivo('ultimos8');
            aplicarFiltrosYActualizar();
        });
    }

    if (btnFiltroAlertas) {
        btnFiltroAlertas.addEventListener('click', function () {
            soloAlertas = !soloAlertas;
            this.classList.toggle('active', soloAlertas);
            this.classList.toggle('btn-warning', soloAlertas);
            this.classList.toggle('text-white', soloAlertas);
            aplicarFiltrosYActualizar();
        });
    }

    function restablecerTodo() {
        periodosSeleccionados = new Set(periodosUnicos);
        soloAlertas = false;
        if (btnFiltroAlertas) btnFiltroAlertas.classList.remove('active', 'btn-warning', 'text-white');
        document.querySelectorAll('.check-periodo-item').forEach(c => { c.checked = true; });
        visibilidadSeries.observados = true;
        visibilidadSeries.proyeccion = true;
        actualizarBotonesVisibilidad();
        setRangoActivo('todos');
        aplicarFiltrosYActualizar();
        try {
            const url = new URL(window.location.href);
            if (url.searchParams.has('periodo')) {
                url.searchParams.delete('periodo');
                window.history.replaceState(null, '', url.toString());
            }
        } catch (e) {}
    }

    if (btnRestablecerFiltros) {
        btnRestablecerFiltros.addEventListener('click', restablecerTodo);
    }
    if (btnRestablecerDesdeMensaje) {
        btnRestablecerDesdeMensaje.addEventListener('click', restablecerTodo);
    }

    // Inicialización del Componente
    actualizarBotonesVisibilidad();
    setRangoActivo(filtroRango);
    renderizarCheckboxesPeriodos();
    aplicarFiltrosYActualizar();
});
</script>

