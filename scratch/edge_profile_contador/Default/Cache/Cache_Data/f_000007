                intersect: true,
            },
            onClick: function(event, elements) {
                if (!elements || elements.length === 0) return;
                const el = elements[0];
                const dataIndex = el.index;

                // Si se hace clic en el nodo destino proyectado, no alterar
                if (el.datasetIndex === 1 && dataIndex === destIdxActual) return;

                const punto = puntosVisiblesActuales[dataIndex];
                if (!punto) return;

                // Posicionar de inmediato en el período de forma reactiva (sin recargar la página)
                posicionarEnPeriodo(punto.periodo, punto.id);
            },
            onHover: function(event, elements) {
                const target = event.native ? event.native.target : ctx;
                if (target) {
                    target.style.cursor = elements && elements.length > 0 ? 'pointer' : 'default';
                }
            },
            scales: {
                y: {
                    min: 0,
                    max: 100,
                    ticks: {
                        stepSize: 20,
                        callback: function(value) { return value + '%'; },
                        font: { size: 11, family: 'monospace' }
                    },
                    grid: {
                        color: 'rgba(226, 232, 240, 0.5)'
                    },
                    title: {
                        display: true,
                        text: 'Nivel de Riesgo / Deterioro (%)',
                        font: { size: 11, weight: '500' }
                    }
                },
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        font: function(context) {
                            const lastIdx = chart ? (chart.data.labels.length - 1) : -1;
                            if (context.index === lastIdx) {
                                return { size: 12, weight: 'bold', family: 'monospace' };
                            }
                            return { size: 11, family: 'monospace' };
                        },
                        color: function(context) {
                            const lastIdx = chart ? (chart.data.labels.length - 1) : -1;
                            if (context.index === lastIdx) {
                                return colorProyeccionActual.border;
                            }
                            return '#475569';
                        }
                    }
                }
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0f172a',
                    titleFont: { size: 12, weight: 'bold' },
                    bodyFont: { size: 11 },
                    padding: 10,
                    cornerRadius: 6,
                    filter: function(tooltipItem) {
                        if (tooltipItem.datasetIndex === 1 && tooltipItem.dataIndex !== destIdxActual) {
                            return !visibilidadSeries.observados;
                        }
                        return true;
                    },
                    callbacks: {
                        title: function(items) {
                            if (!items || !items.length) return '';
                            const idx = items[0].dataIndex;
                            if (items[0].datasetIndex === 1 && idx === destIdxActual) {
                                return 'Pronóstico Preventivo AI (90 días - Q(t+1)): ' + items[0].label;
                            }
                            const isAct = esActualArr[idx];
                            return 'Trimestre ' + items[0].label + (isAct ? '  [ACTUAL]' : '');
                        },
                        label: function (context) {
                            const val = context.parsed.y;
                            if (val === null || val === undefined) return '';
                            const idx = context.dataIndex;

                            if (context.datasetIndex === 1) {
                                if (idx !== destIdxActual) {
                                    return 'Riesgo Observado Base (Q_t): ' + val.toFixed(1) + '%';
                                }
                                let estadoProy = val > 70 ? 'Crítica (>70%)' : (val > 35 ? 'Preventiva / Alerta (35-70%)' : 'Solvente (≤35%)');
                                return 'Pronóstico Machine Learning 90d: ' + val.toFixed(1) + '% | Probabilidad de Insolvencia: ' + estadoProy;
                            }

                            let zonaTexto = val > 70 ? 'Zona Crítica' : (val > 35 ? 'Zona Gris' : 'Zona Segura');
                            return 'Riesgo: ' + val.toFixed(1) + '% | ' + zonaTexto;
                        },
                        afterLabel: function(ctx) {
                            const idx = ctx.dataIndex;
                            if (ctx.datasetIndex === 1) {
                                if (idx !== destIdxActual) {
                                    return '● Balance actual seleccionado (punto de partida de la proyección)';
                                }
                                const origenStr = puntoActivoActual ? ` desde ${puntoActivoActual.label}` : '';
                                return `Pronóstico preventivo generado por Random Forest AI anticipando el estado en ${ctx.label}${origenStr}.`;
                            }
                            if (esActualArr[idx]) {
                                if (visibilidadSeries.proyeccion && puntoActivoActual) {
                                    return `● Balance actual seleccionado (pronóstico 90d a ${puntoActivoActual.periodo_proyectado}: ${puntoActivoActual.score_prediccion.toFixed(1)}%)`;
                                }
                                return '● Balance actual seleccionado';
                            }
                            return '👉 Clic para situar el análisis en este trimestre';
                        }
                    }
                }
            }
        }
    });

    // 6. Función Núcleo de Filtrado y Actualización de la Curva (RF-04)
    function aplicarFiltrosYActualizar() {
        // Filtrar puntos cuyos períodos estén marcados
        let visibles = puntosOriginales.filter(p => periodosSeleccionados.has(p.periodo));

        // Aplicar filtro de rango si no es 'todos'
        if (filtroRango === 'ultimos4' || filtroRango === 'ultimos3') {
            visibles = visibles.slice(-4);
        } else if (filtroRango === 'ultimos8' || filtroRango === 'ultimos5') {
            visibles = visibles.slice(-8);
        }

        // Aplicar filtro de solo alertas si está activo
        if (soloAlertas) {
            visibles = visibles.filter(p => p.score_prediccion > 35 || p.score_observado > 35);
        }

        // Guardar referencia exacta de los puntos visibles tras todos los filtros
        puntosVisiblesActuales = visibles;

        // Control visual del mensaje de estado cuando no hay períodos visibles
        if (visibles.length === 0) {
            activeIdxActual = -1;
            destIdxActual = -1;
            puntoActivoActual = null;
            esActualArr = [];
            if (mensajeSinPeriodos) mensajeSinPeriodos.classList.remove('d-none');
            ctx.style.opacity = '0.15';
            chart.data.labels = [];
            chart.data.datasets[0].data = [];
            chart.data.datasets[1].data = [];
            chart.update();

            if (badgeActivos) badgeActivos.textContent = `${periodosSeleccionados.size}/${periodosUnicos.length}`;
            if (contadorPuntos) contadorPuntos.textContent = `0 de ${puntosOriginales.length} trimestres`;
            if (puntosFooter) puntosFooter.textContent = 0;
            if (btnRestablecerFiltros) btnRestablecerFiltros.classList.remove('d-none');
            return;
        }

        if (mensajeSinPeriodos) mensajeSinPeriodos.classList.add('d-none');
        ctx.style.opacity = '1';

        const M = visibles.length;

        // Determinar índice del período activo dentro de los visibles (sin mutar puntosOriginales)
        let activeIdx = visibles.findIndex(p => p.es_actual);
        if (activeIdx === -1) {
            activeIdx = M - 1;
        }
        const puntoActivo = visibles[activeIdx];

        // Etiquetas del eje X: todas las visibles + la proyección del último período
        const lastPunto = visibles[M - 1];
        const nextFuturoLabel = lastPunto.periodo_proyectado || periodoProyectadoLabel;
        const newLabels = visibles.map(p => p.label).concat([nextFuturoLabel]);

        // Dataset 0: Datos Observados (longitud M + 1, con null al final)
        const newObservados = visibles.map(p => p.score_observado).concat([null]);

        // Dataset 1: Tramo proyectado dinámico que SALE del período activo hacia su trimestre siguiente (+90 días)
        const newProyectado = new Array(M + 1).fill(null);
        let destIdx = (activeIdx < M - 1) ? (activeIdx + 1) : M;
        newProyectado[activeIdx] = puntoActivo.score_observado;
        newProyectado[destIdx] = puntoActivo.score_prediccion;

        activeIdxActual = activeIdx;
        destIdxActual = destIdx;
        puntoActivoActual = puntoActivo;

        esActualArr = visibles.map((_, idx) => idx === activeIdx).concat([false]);
        const colorActivoSem = getColorSemaforo(puntoActivo.score_prediccion);
        colorProyeccionActual = colorActivoSem;
        if (indicadorLeyendaProyeccion) {
            indicadorLeyendaProyeccion.style.borderTopColor = colorActivoSem.border;
        }

        // Styling Dataset 0 (Observados)
        const obsPointRadii = visibles.map((_, idx) => idx === activeIdx ? 7.5 : 5.5).concat([0]);
        const obsPointHoverRadii = visibles.map((_, idx) => idx === activeIdx ? 10 : 8).concat([0]);
        const obsPointBorders = visibles.map((_, idx) => idx === activeIdx ? '#0f172a' : '#ffffff').concat(['transparent']);
        const obsPointBorderWidths = visibles.map((_, idx) => idx === activeIdx ? 3 : 2).concat([0]);
        const obsPointBg = visibles.map(() => '#2563eb').concat(['transparent']);

        // Styling Dataset 1 (Proyección a 90 días)
        const projPointRadii = new Array(M + 1).fill(0);
        projPointRadii[activeIdx] = visibilidadSeries.observados ? 0 : 4;
        projPointRadii[destIdx] = 9;
        const projPointHoverRadii = new Array(M + 1).fill(0);
        projPointHoverRadii[activeIdx] = visibilidadSeries.observados ? 0 : 6;
        projPointHoverRadii[destIdx] = 12;
        const projPointHitRadii = new Array(M + 1).fill(0);
        projPointHitRadii[activeIdx] = visibilidadSeries.observados ? 0 : 8;
        projPointHitRadii[destIdx] = 12;
        const projPointBg = new Array(M + 1).fill(colorActivoSem.border);
        projPointBg[activeIdx] = '#ffffff';

        chart.data.labels = newLabels;

        // Dataset 0
        chart.data.datasets[0].data = newObservados;
        chart.data.datasets[0].pointRadius = obsPointRadii;
        chart.data.datasets[0].pointHoverRadius = obsPointHoverRadii;
        chart.data.datasets[0].pointBorderColor = obsPointBorders;
        chart.data.datasets[0].pointBorderWidth = obsPointBorderWidths;
        chart.data.datasets[0].pointBackgroundColor = obsPointBg;

