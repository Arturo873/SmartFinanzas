            contadorPuntos.textContent = `${visibles.length} de ${puntosOriginales.length} trimestres`;
        }
        if (puntosFooter) {
            puntosFooter.textContent = visibles.length;
        }
        if (totalFooter) {
            totalFooter.textContent = puntosOriginales.length;
