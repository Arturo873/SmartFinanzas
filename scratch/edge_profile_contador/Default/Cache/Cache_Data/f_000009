    <!-- Script para alternar el Sidebar en dispositivos móviles e inicializar Tooltips -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Inicialización global de Tooltips Bootstrap
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl);
            });

            const sidebar = document.getElementById('sidebarNav');
            const toggleBtn = document.getElementById('sidebarToggle');
            const backdrop = document.getElementById('sidebarBackdrop');

            if (toggleBtn && sidebar && backdrop) {
                function toggleSidebar() {
                    sidebar.classList.toggle('show');
                    backdrop.classList.toggle('show');
                }

                toggleBtn.addEventListener('click', toggleSidebar);
                backdrop.addEventListener('click', toggleSidebar);
            }

            // Manejador del botón y formulario "Ejecutar Análisis" (RF-11)
            const formsEjecutar = document.querySelectorAll('.form-ejecutar-analisis');
            const modalCargaEl = document.getElementById('modalCargaAnalisis');
            let modalCargaInstance = null;

            formsEjecutar.forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    // Deshabilitar botón para prevenir doble clic y mostrar spinner en botón
                    const submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Ejecutando Análisis...';
                    }

                    // Cerrar cualquier modal abierto (ej. modal de advertencia de outliers)
                    const modalesAbiertos = document.querySelectorAll('.modal.show');
                    modalesAbiertos.forEach(function (m) {
                        const inst = bootstrap.Modal.getInstance(m);
                        if (inst) inst.hide();
                    });

                    // Mostrar barra / spinner de carga en modal persistente
                    if (modalCargaEl && typeof bootstrap !== 'undefined') {
                        if (!modalCargaInstance) {
                            modalCargaInstance = new bootstrap.Modal(modalCargaEl, { backdrop: 'static', keyboard: false });
                        }
                        modalCargaInstance.show();
                    }
                });
            });
        });
    </script>

    
<script>
document.addEventListener('DOMContentLoaded', function() {
    const LIMITE_MAX_BYTES = 25 * 1024 * 1024; // 25 MB (RNF-10)
    const LIMITE_MAX_MB = 25;

    const inputArchivo = document.getElementById('id_archivo_datos');
    const formCarga = document.getElementById('formCargaETL');
    const btnSubmit = document.getElementById('btnSubmit');
    const alertaTamano = document.getElementById('alertaTamanoArchivo');
    const mensajeTamano = document.getElementById('mensajeTamanoArchivo');
    const infoValido = document.getElementById('infoArchivoValido');
    const mensajeValido = document.getElementById('mensajeArchivoValido');
    const dropZone = document.getElementById('dropZone');
    const dropZoneContent = document.getElementById('dropZoneContent');
    const dropZoneSelected = document.getElementById('dropZoneSelected');
    const selectedFileName = document.getElementById('selectedFileName');
    const selectedFileSize = document.getElementById('selectedFileSize');
    const btnRemoverArchivo = document.getElementById('btnRemoverArchivo');

    function actualizarEstadoBtnSubmit() {
        if (!btnSubmit) return;
        const tieneArchivo = inputArchivo && inputArchivo.files && inputArchivo.files.length > 0;
        const checkMarcado = checkPrincipalETL && checkPrincipalETL.checked;
        const archivoValido = tieneArchivo && (inputArchivo.files[0].size <= LIMITE_MAX_BYTES);
        btnSubmit.disabled = !(tieneArchivo && checkMarcado && archivoValido);
    }

    function actualizarVistaArchivo(archivo) {
        if (!archivo) {
            dropZoneContent.classList.remove('d-none');
            dropZoneSelected.classList.add('d-none');
            dropZone.classList.remove('border-success', 'bg-success', 'bg-opacity-10');
            if (alertaTamano) alertaTamano.classList.add('d-none');
            if (infoValido) infoValido.classList.add('d-none');
            actualizarEstadoBtnSubmit();
            return;
        }

        const tamanoMB = (archivo.size / (1024 * 1024)).toFixed(2);

        if (archivo.size > LIMITE_MAX_BYTES) {
            if (mensajeTamano) {
                mensajeTamano.textContent = `El archivo seleccionado ("${archivo.name}") pesa ${tamanoMB} MB, superando el límite de ${LIMITE_MAX_MB} MB permitido.`;
            }
            if (alertaTamano) {
                alertaTamano.classList.remove('d-none');
                alertaTamano.classList.add('d-flex');
            }
            if (infoValido) infoValido.classList.add('d-none');
            inputArchivo.value = '';
            dropZoneContent.classList.remove('d-none');
            dropZoneSelected.classList.add('d-none');
            dropZone.classList.remove('border-success', 'bg-success', 'bg-opacity-10');
            actualizarEstadoBtnSubmit();
            return;
        }

        if (alertaTamano) alertaTamano.classList.add('d-none');
        if (infoValido && mensajeValido) {
            mensajeValido.textContent = `Archivo seleccionado correctamente: "${archivo.name}" (${tamanoMB} MB / ${LIMITE_MAX_MB} MB máx).`;
            infoValido.classList.remove('d-none');
            infoValido.classList.add('d-flex');
        }
        selectedFileName.textContent = archivo.name;
        selectedFileSize.textContent = `${tamanoMB} MB`;
        dropZoneContent.classList.add('d-none');
        dropZoneSelected.classList.remove('d-none');
        dropZone.classList.add('border-success', 'bg-success', 'bg-opacity-10');
        actualizarEstadoBtnSubmit();
    }

    if (inputArchivo) {
        inputArchivo.addEventListener('change', function() {
            if (this.files && this.files.length > 0) {
                actualizarVistaArchivo(this.files[0]);
            } else {
                actualizarVistaArchivo(null);
            }
        });
    }

    if (btnRemoverArchivo) {
        btnRemoverArchivo.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (inputArchivo) inputArchivo.value = '';
            actualizarVistaArchivo(null);
        });
    }

    // Drag and drop visual cues
    if (dropZone) {
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, function(e) {
                e.preventDefault();
                e.stopPropagation();
                dropZone.classList.add('border-primary', 'bg-primary', 'bg-opacity-10');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, function(e) {
                e.preventDefault();
                e.stopPropagation();
                dropZone.classList.remove('border-primary', 'bg-primary', 'bg-opacity-10');
            }, false);
        });
    }

    // Sincronización Modal Términos IFRS
    const checkPrincipalETL = document.getElementById('checkTerminosETL');
    const checkModalETL = document.getElementById('checkModalETL');
    const btnAceptarModalETL = document.getElementById('btnAceptarModalETL');
    const modalElETL = document.getElementById('modalTerminosETL');

    if (modalElETL) {
        modalElETL.addEventListener('show.bs.modal', function () {
            if (checkModalETL) checkModalETL.checked = false;
            if (btnAceptarModalETL) btnAceptarModalETL.disabled = true;
        });
    }

    if (checkModalETL && btnAceptarModalETL) {
        checkModalETL.addEventListener('change', function () {
            btnAceptarModalETL.disabled = !this.checked;
        });

        btnAceptarModalETL.addEventListener('click', function () {
            if (checkPrincipalETL) {
                checkPrincipalETL.checked = true;
                checkPrincipalETL.dispatchEvent(new Event('change'));
            }
            if (modalElETL && typeof bootstrap !== 'undefined') {
                const modalInstance = bootstrap.Modal.getInstance(modalElETL) || new bootstrap.Modal(modalElETL);
                modalInstance.hide();
            }
        });
    }

    const errorCheckTerminos = document.getElementById('errorCheckTerminos');
    const cardCheckTerminos = document.getElementById('cardCheckTerminos');

    if (checkPrincipalETL) {
        checkPrincipalETL.addEventListener('change', function() {
            if (this.checked) {
                this.classList.remove('is-invalid');
                if (errorCheckTerminos) errorCheckTerminos.classList.add('d-none');
                if (cardCheckTerminos) cardCheckTerminos.classList.remove('border', 'border-danger');
            }
            actualizarEstadoBtnSubmit();
        });
        actualizarEstadoBtnSubmit();
    }

    // Spinner y validación en submit de carga de balance
    if (formCarga) {
        formCarga.addEventListener('submit', function(e) {
            // 1. Validar que se haya seleccionado un archivo
            if (!inputArchivo || !inputArchivo.files || inputArchivo.files.length === 0) {
                e.preventDefault();
                e.stopPropagation();
                alert('Debe seleccionar un archivo Excel (.xlsx, .xls) o CSV (.csv) para procesar.');
                if (inputArchivo) inputArchivo.focus();
                return false;
            }

            // 2. Validar tamaño de archivo (25 MB)
            const archivo = inputArchivo.files[0];
            if (archivo.size > LIMITE_MAX_BYTES) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }

            // 3. Validar obligatoriedad del check de Términos IFRS
            if (checkPrincipalETL && !checkPrincipalETL.checked) {
                e.preventDefault();
                e.stopPropagation();
                checkPrincipalETL.focus();
                checkPrincipalETL.classList.add('is-invalid');
                if (cardCheckTerminos) cardCheckTerminos.classList.add('border', 'border-danger');
                if (errorCheckTerminos) errorCheckTerminos.classList.remove('d-none');
                return false;
            }

            // 4. Si es válido, activar spinner
            if (btnSubmit) {
                btnSubmit.disabled = true;
                btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Extrayendo y procesando ratios en memoria...';
            }
        });
    }

    // ======================================================================
    // LÓGICA DE SELECCIÓN DE PERÍODOS PARA PREDICCIÓN ML
    // ======================================================================
    const formPeriodosML = document.getElementById('formSeleccionPeriodosML');
    const btnEjecutarModal = document.getElementById('btnEjecutarPrediccionModal');
    const chkPeriodos = document.querySelectorAll('.check-periodo-item');
    const modoJuntos = document.getElementById('modoJuntos');
    const modoSeparados = document.getElementById('modoSeparados');
    const btnMarcarTodos = document.getElementById('btnMarcarTodos');
    const btnDesmarcarTodos = document.getElementById('btnDesmarcarTodos');
    const contadorSeleccionados = document.getElementById('contadorSeleccionados');
    const alertaVacio = document.getElementById('alertaPeriodosVacio');
    const formPrediccionUnica = document.getElementById('formPrediccionUnica');
    const btnPrediccionUnica = document.getElementById('btnEjecutarPrediccionUnica');

    function actualizarContadorPeriodos() {
        if (!chkPeriodos || chkPeriodos.length === 0) return;
        let seleccionados = 0;
        chkPeriodos.forEach(chk => {
            if (chk.checked) seleccionados++;
        });

        if (contadorSeleccionados) {
            contadorSeleccionados.textContent = `${seleccionados} de ${chkPeriodos.length} seleccionados`;
        }

        if (seleccionados === 0) {
            if (alertaVacio) alertaVacio.classList.remove('d-none');
            if (btnEjecutarModal) btnEjecutarModal.disabled = true;
        } else {
            if (alertaVacio) alertaVacio.classList.add('d-none');
            if (btnEjecutarModal) btnEjecutarModal.disabled = false;
        }

        if (modoJuntos && modoSeparados) {
            if (seleccionados === chkPeriodos.length) {
                modoJuntos.checked = true;
            } else {
                modoSeparados.checked = true;
            }
        }
    }

    if (modoJuntos) {
        modoJuntos.addEventListener('change', function() {
            if (this.checked) {
                chkPeriodos.forEach(chk => chk.checked = true);
                actualizarContadorPeriodos();
            }
        });
    }

    if (modoSeparados) {
        modoSeparados.addEventListener('change', function() {
            actualizarContadorPeriodos();
        });
    }

    if (btnMarcarTodos) {
        btnMarcarTodos.addEventListener('click', function(e) {
            e.preventDefault();
            chkPeriodos.forEach(chk => chk.checked = true);
            actualizarContadorPeriodos();
        });
    }

    if (btnDesmarcarTodos) {
        btnDesmarcarTodos.addEventListener('click', function(e) {
            e.preventDefault();
            chkPeriodos.forEach(chk => chk.checked = false);
            actualizarContadorPeriodos();
        });
    }

    chkPeriodos.forEach(chk => {
        chk.addEventListener('change', actualizarContadorPeriodos);
    });
    actualizarContadorPeriodos();

    if (formPeriodosML) {
        formPeriodosML.addEventListener('submit', function(e) {
            let seleccionados = 0;
            chkPeriodos.forEach(chk => {
                if (chk.checked) seleccionados++;
            });

            if (seleccionados === 0) {
                e.preventDefault();
                e.stopPropagation();
                if (alertaVacio) alertaVacio.classList.remove('d-none');
                return false;
            }

            if (btnEjecutarModal) {
                btnEjecutarModal.disabled = true;
                btnEjecutarModal.innerHTML = '<span class="spinner-border spinner-border-sm me-2 text-dark" role="status" aria-hidden="true"></span>Evaluando ' + seleccionados + ' predicción(es) ML...';
            }
        });
    }

    if (formPrediccionUnica) {
        formPrediccionUnica.addEventListener('submit', function() {
            if (btnPrediccionUnica) {
                btnPrediccionUnica.disabled = true;
                btnPrediccionUnica.innerHTML = '<span class="spinner-border spinner-border-sm me-2 text-dark" role="status" aria-hidden="true"></span>Evaluando predicción ML...';
            }
        });
    }
});
</script>

