# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example) - SmartFinanzas
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo como ".env" en la raíz del proyecto.
# 2. Ajusta los valores de acuerdo a tu entorno local o servidor de producción.
# 3. El archivo ".env" real NUNCA debe subirse a Git (ya está en el .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN GENERAL DE DJANGO
# ------------------------------------------------------------------------------

# Modo depuración:
# - True:  Para desarrollo local. Muestra errores detallados y ayuda a depurar.
# - False: Para servidores en producción. Oculta rutas, código y fallos a usuarios.
DEBUG=True

# Clave criptográfica única del proyecto:
# Se utiliza para firmar cookies de sesión, tokens CSRF y proteger contraseñas.
# En producción DEBE ser una cadena larga, secreta y aleatoria.
SECRET_KEY=django-insecure-tx!@obs@8uu=6h(uftth-8%=$7v4_xlu5pvq6(qv)kjj4uscv$
#tu-clave-secreta-aqui-generada-para-django

# Hosts/Dominios permitidos (separados por coma, opcional en desarrollo):
# Ejemplo en producción: ALLOWED_HOSTS=midominio.cl,www.midominio.cl
# ALLOWED_HOSTS=localhost,127.0.0.1


# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (MySQL / MariaDB en XAMPP o Servidor Local)
# ------------------------------------------------------------------------------

# Motor de base de datos de Django para MySQL/MariaDB:
DB_ENGINE=django.db.backends.mysql

# Nombre de la base de datos en phpMyAdmin / MariaDB:
DB_NAME=smartfinanzas

# Usuario de la base de datos (por defecto 'root' en XAMPP):
DB_USER=root

# Contraseña del usuario (en XAMPP por defecto viene vacía, sin contraseña):
DB_PASSWORD=

# Dirección del servidor de base de datos ('localhost' o '127.0.0.1'):
DB_HOST=localhost

# Puerto estándar de conexión MySQL/MariaDB (por defecto 3306):
DB_PORT=3306


# ------------------------------------------------------------------------------
# 3. MODELO DE MACHINE LEARNING (Capa Analítica / Inferencia de Riesgo)
# ------------------------------------------------------------------------------
# Nombre del archivo del modelo Random Forest pre-entrenado (.joblib)
# Ubicación estándar de búsqueda: capaAnalitica/modelo/
MODELO_ML_NOMBRE=modelo_riesgo_v11.joblib
ML_MODEL_NAME=modelo_riesgo_v11.joblib

